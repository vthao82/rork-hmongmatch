rules_version = '2';

// Hmong Date — Firestore security rules
//
// Deploy steps (no CLI required):
//   1. Open Firebase Console → Firestore Database → Rules tab
//   2. Replace the entire ruleset with the contents of this file
//   3. Click "Publish"
//
// Or via CLI: firebase deploy --only firestore:rules
//
// Schema covered:
//   /users/{uid}                        — profile docs
//   /users/{uid}/swipes/{otherUid}      — swipe history (owner-only)
//   /matches/{matchId}                  — mutual-like match docs (participants-only)
//   /matches/{matchId}/messages/{msgId} — chat messages (participants-only)

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: is the authed user one of the participants in this match?
    function isMatchParticipant(matchId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && get(/databases/$(database)/documents/matches/$(matchId))
              .data.userIds.hasAny([request.auth.uid]);
    }

    // A match-list field may only change by adding/removing the caller's own uid
    function onlyOwnChange(field) {
      let before = resource.data.get(field, []).toSet();
      let after = request.resource.data.get(field, []).toSet();
      return after.difference(before).union(before.difference(after)).hasOnly([request.auth.uid]);
    }

    // -------- Users (profiles) --------
    match /users/{uid} {
      // Any signed-in user can read profiles (Discover feed, chat avatars, etc.)
      allow read: if request.auth != null;
      // Only the owner can create / update / delete their own profile (never the admin-only comp flag)
      allow create: if request.auth != null && request.auth.uid == uid
                    && !('complimentaryUnlimited' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == uid
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['complimentaryUnlimited']);
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Swipes subcollection — owner-only
      // Note: when checking for a mutual like, the OTHER user's swipe is read via
      // the recordSwipe() flow. To allow that read we relax read on swipes to any
      // signed-in user (write stays owner-only).
      match /swipes/{otherUid} {
        allow read: if request.auth != null
                    && (request.auth.uid == uid || request.auth.uid == otherUid);
        allow create, update, delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Blocks: my list is private to me; the mirror lets the blocked person's app hide me
    match /users/{uid}/blocked/{otherUid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/blockedBy/{blockerUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if request.auth != null && request.auth.uid == blockerUid;
    }

    // Private owner-only docs (e.g. unfinished sign-up draft)
    match /users/{uid}/private/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Inbox of likes I've received — I can read it, only the liker can write their own entry
    match /users/{uid}/likesReceived/{likerUid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if request.auth != null && request.auth.uid == likerUid;
    }

    // -------- Matches --------
    match /matches/{matchId} {
      // Any signed-in user can create a match doc, but the resource MUST include
      // their uid in userIds (prevents creating matches for other people).
      allow create: if request.auth != null
                    && request.resource.data.userIds is list
                    && request.resource.data.userIds.size() == 2
                    && request.resource.data.userIds.hasAny([request.auth.uid]);
      // Read: participant (or the doc doesn't exist yet, so recordSwipe can check)
      allow read: if request.auth != null
                  && (resource == null || resource.data.userIds.hasAny([request.auth.uid]));
      allow delete: if request.auth != null
                    && resource.data.userIds.hasAny([request.auth.uid]);
      // Update: participant, and the participant list can't change
      allow update: if request.auth != null
                    && resource.data.userIds.hasAny([request.auth.uid])
                    && request.resource.data.userIds == resource.data.userIds
                    && onlyOwnChange('unmatchedBy')
                    && onlyOwnChange('blockedBy')
                    && onlyOwnChange('celebratedBy');

      // Read receipts: participants read; each writes only their own "seen" time
      match /reads/{readerUid} {
        allow read: if isMatchParticipant(matchId);
        allow write: if isMatchParticipant(matchId) && request.auth.uid == readerUid;
      }

      // Typing indicator: participants read; each writes only their own doc
      match /typing/{typerUid} {
        allow read: if isMatchParticipant(matchId);
        allow write: if isMatchParticipant(matchId) && request.auth.uid == typerUid;
      }

      // -------- Messages (chat) --------
      match /messages/{messageId} {
        // Participants of the parent match can read all messages
        allow read: if isMatchParticipant(matchId);

        // Participants can create a message. Sender must be the authed user.
        allow create: if isMatchParticipant(matchId)
                      && get(/databases/$(database)/documents/matches/$(matchId)).data.get('blockedBy', []).size() == 0
                      && get(/databases/$(database)/documents/matches/$(matchId)).data.get('unmatchedBy', []).size() == 0
                      && request.resource.data.text is string
                      && request.resource.data.text.size() <= 2000
                      && (request.resource.data.text.size() > 0
                          || (request.resource.data.imageUrl is string
                              && request.resource.data.imageUrl.matches('https://firebasestorage[.]googleapis[.]com/.*')))
                      && request.resource.data.senderId == request.auth.uid;

        // Participants may only update readBy and their own reaction (message text is never editable)
        allow update: if isMatchParticipant(matchId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'reactions'])
                      && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([request.auth.uid])
                      && request.resource.data.get('readBy', []).toSet().difference(resource.data.get('readBy', []).toSet()).hasOnly([request.auth.uid]);

        // No deletes from clients
        allow delete: if false;
      }
    }

    // -------- Tester feedback (write-only for members; admins read in Console) --------
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
    }

    // -------- Reports (user-submitted abuse / bug reports) --------
    match /reports/{reportId} {
      // Any signed-in user can create a report. Their uid must be in the doc.
      allow create: if request.auth != null
                    && request.resource.data.reporterUid == request.auth.uid;
      // Read/update/delete only by reporter (admins use Firebase Console / Admin SDK)
      allow read, update, delete: if request.auth != null
                                  && resource.data.reporterUid == request.auth.uid;
    }
  }
}
